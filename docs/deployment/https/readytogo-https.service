[Unit]
Description=ReadytoGo IP HTTPS reverse proxy
Wants=network-online.target
After=network-online.target readytogo.service

[Service]
Type=notify
DynamicUser=yes
StateDirectory=readytogo-https
StateDirectoryMode=0700
WorkingDirectory=/var/lib/readytogo-https
Environment=XDG_DATA_HOME=/var/lib/readytogo-https/data
Environment=XDG_CONFIG_HOME=/var/lib/readytogo-https/config
ExecStart=/opt/readytogo-https/caddy-v2.11.7/caddy run --config /etc/readytogo-https/Caddyfile --adapter caddyfile
ExecReload=/opt/readytogo-https/caddy-v2.11.7/caddy reload --config /etc/readytogo-https/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=1048576
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
