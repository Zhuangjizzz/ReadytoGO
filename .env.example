# Server-side credentials. Fill locally; keep real values out of Git.
DASHSCOPE_API_KEY=
QWEN_REGION=cn-beijing
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Verified by a bounded JSON response probe on 2026-10-08.
QWEN_MODEL=qwen3.8-flash
AMAP_KEY=
# Optional only when downloading a fresh government data file.
BJDATA_KEY=

# Optional application paths and port. Generated files are ignored by Git.
PORT=3001
# CATALOG_PATH=data/generated/catalog.json
# MATCH_CACHE_PATH=data/generated/matches.json
